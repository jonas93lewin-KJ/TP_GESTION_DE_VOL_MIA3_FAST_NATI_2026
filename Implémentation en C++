// Date du jour au format JJ/MM/AAAA
string dateDuJour() {
    time_t maintenant = time(nullptr);
    tm* t = localtime(&maintenant);
    char tampon[11];
    strftime(tampon, sizeof(tampon), "%d/%m/%Y", t);
    return string(tampon);
}

// Aujourd'hui à minuit
time_t minuitAujourdhui() {
    time_t maintenant = time(nullptr);
    tm t = *localtime(&maintenant);
    t.tm_hour = 0;
    t.tm_min = 0;
    t.tm_sec = 0;
    t.tm_isdst = -1;
    return mktime(&t);
}

// Convertit "JJ/MM/AAAA" en time_t (à minuit).
// Retourne false si le format ou la date est invalide.
bool analyserDate(const string& texte, time_t& resultat) {
    int j, m, a;
    char reste;
    if (sscanf(texte.c_str(), "%d/%d/%d %c", &j, &m, &a, &reste) != 3) return false;
    tm t = {};
    t.tm_mday = j;
    t.tm_mon = m - 1;
    t.tm_year = a - 1900;
    t.tm_isdst = -1;
    time_t r = mktime(&t);
    if (r == static_cast<time_t>(-1) || t.tm_mday != j || t.tm_mon != m - 1 ||
        t.tm_year != a - 1900)
        return false;
    resultat = r;
    return true;
}

bool dateValide(const string& texte) {
    time_t t;
    return analyserDate(texte, t);
}

// Téléphone : 8 à 15 chiffres, avec éventuellement '+' et espaces
bool telephoneValide(const string& t) {
    int chiffres = 0;
    for (char c : t) {
        if (isdigit(static_cast<unsigned char>(c)))
            ++chiffres;
        else if (c != '+' && c != ' ')
            return false;
    }
    return chiffres >= 8 && chiffres <= 15;
}

// Email : forme minimale  x@y.z
bool emailValide(const string& e) {
    if (e.find(' ') != string::npos) return false;
    size_t arobase = e.find('@');
    if (arobase == string::npos || arobase == 0) return false;
    size_t point = e.find('.', arobase);
    return point != string::npos && point > arobase + 1 && point < e.size() - 1;
}

string enMajuscules(string s) {
    transform(s.begin(), s.end(), s.begin(),
              [](unsigned char c) { return static_cast<char>(toupper(c)); });
    return s;
}

string nettoyer(const string& s) {
    size_t debut = s.find_first_not_of(" \t\r\n");
    if (debut == string::npos) return "";
    size_t fin = s.find_last_not_of(" \t\r\n");
    return s.substr(debut, fin - debut + 1);
}

