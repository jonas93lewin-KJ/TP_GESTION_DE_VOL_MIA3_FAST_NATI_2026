class Passager {
private:
    int id;
    string nom;
    string prenom;
    string telephone;
    string email;

public:
    Passager(int id, const string& nom, const string& prenom, const string& telephone,
             const string& email)
        : id(id) {
        setNom(nom);
        setPrenom(prenom);
        setTelephone(telephone);
        setEmail(email);
    }

    // Accesseurs
    int getId() const { return id; }
    const string& getNom() const { return nom; }
    const string& getPrenom() const { return prenom; }
    const string& getTelephone() const { return telephone; }
    const string& getEmail() const { return email; }

    // Modificateurs (avec contrôle de validité)
    void setNom(const string& n) {
        if (n.empty()) throw invalid_argument("Le nom est obligatoire.");
        nom = n;
    }
    void setPrenom(const string& p) {
        if (p.empty()) throw invalid_argument("Le prénom est obligatoire.");
        prenom = p;
    }
    void setTelephone(const string& t) {
        if (!telephoneValide(t))
            throw invalid_argument("Téléphone invalide (8 à 15 chiffres attendus).");
        telephone = t;
    }
    void setEmail(const string& e) {
        if (!emailValide(e)) throw invalid_argument("Email invalide (exemple : nom@mail.com).");
        email = e;
    }

    void afficher() const {
        cout << "Passager n°" << id << " : " << prenom << " " << nom << " | Tél : " << telephone
             << " | Email : " << email << "\n";
    }
};

// ======================================================================
//  4. CLASSE VOL
// ======================================================================

class Vol {
private:
    string numero;
    string depart;
    string destination;
    string dateDepart;  // format JJ/MM/AAAA
    int capacite;
    int placesReservees;  // places des réservations VALIDÉES uniquement

public:
    Vol(const string& numero, const string& depart, const string& destination,
        const string& dateDepart, int capacite)
        : capacite(0), placesReservees(0) {
        if (numero.empty()) throw invalid_argument("Le numéro de vol est obligatoire.");
        this->numero = enMajuscules(numero);
        setDepart(depart);
        setDestination(destination);
        setDateDepart(dateDepart);
        setCapacite(capacite);
    }

    // Accesseurs
    const string& getNumero() const { return numero; }
    const string& getDepart() const { return depart; }
    const string& getDestination() const { return destination; }
    const string& getDateDepart() const { return dateDepart; }
    int getCapacite() const { return capacite; }
    int getPlacesReservees() const { return placesReservees; }

    // Modificateurs (avec contrôle de validité)
    void setDepart(const string& d) {
        if (d.empty()) throw invalid_argument("La ville de départ est obligatoire.");
        depart = d;
    }
    void setDestination(const string& d) {
        if (d.empty()) throw invalid_argument("La destination est obligatoire.");
        destination = d;
    }
    void setDateDepart(const string& d) {
        if (!dateValide(d)) throw invalid_argument("Date invalide (format JJ/MM/AAAA).");
        dateDepart = d;
    }
    void setCapacite(int c) {
        if (c <= 0) throw invalid_argument("La capacité doit être positive.");
        if (c < placesReservees)
            throw invalid_argument("La capacité est inférieure au nombre de places déjà réservées.");
        capacite = c;
    }

    // Gestion des places
    int placesDisponibles() const { return capacite - placesReservees; }

    // Règle 2 : on ne dépasse jamais la capacité du vol
    bool reserverPlace() {
        if (placesReservees >= capacite) return false;
        ++placesReservees;
        return true;
    }

    void libererPlace() {
        if (placesReservees > 0) --placesReservees;
    }

    // Un vol est parti si sa date de départ est avant aujourd'hui
    bool dejaParti() const {
        time_t depart_t;
        if (!analyserDate(dateDepart, depart_t)) return true;
        return depart_t < minuitAujourdhui();
    }

    bool estDisponible() const { return placesDisponibles() > 0 && !dejaParti(); }

    // Le départ est considéré à minuit le jour de la date de départ
    bool departDansPlusDe24h() const {
        time_t depart_t;
        if (!analyserDate(dateDepart, depart_t)) return false;
        return difftime(depart_t, time(nullptr)) > 24 * 3600;
    }

    void afficher() const {
        cout << "Vol " << numero << " : " << depart << " -> " << destination << " | Départ : "
             << dateDepart << " | Places : " << placesReservees << "/" << capacite
             << " (disponibles : " << placesDisponibles() << ")\n";
    }
};

// ======================================================================
//  5. CLASSE PAIEMENT
